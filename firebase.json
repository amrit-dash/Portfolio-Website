{
  "hosting": [
    {
      "target": "amrit-dash-portfolio",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        { "source": "/admin{,/**}", "destination": "/admin/index.html" },
        { "source": "/dashboard{,/**}", "destination": "/dashboard/index.html" },
        { "source": "**", "destination": "/index.html" }
      ],
      "headers": [
        {
          "source": "/admin{,/**}",
          "headers": [
            { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
            { "key": "Cache-Control", "value": "no-store" }
          ]
        }
      ]
    },
    {
      "target": "amritdash",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        { "source": "/admin{,/**}", "destination": "/admin/index.html" },
        { "source": "/dashboard{,/**}", "destination": "/dashboard/index.html" },
        { "source": "**", "destination": "/index.html" }
      ],
      "headers": [
        {
          "source": "/admin{,/**}",
          "headers": [
            { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
            { "key": "Cache-Control", "value": "no-store" }
          ]
        }
      ]
    }
  ]
}
