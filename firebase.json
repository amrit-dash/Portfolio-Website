{
  "hosting": [
    {
      "target": "amrit-dash-portfolio",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "firebase-config.js"
      ],
      "rewrites": [
        { "source": "/admin",       "destination": "/admin.html" },
        { "source": "/admin/**",    "destination": "/admin.html" },
        { "source": "/dashboard",   "destination": "/admin.html" },
        { "source": "/dashboard/**","destination": "/admin.html" },
        { "source": "**",           "destination": "/index.html" }
      ]
    },
    {
      "target": "amritdash",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "firebase-config.js"
      ],
      "rewrites": [
        { "source": "/admin",       "destination": "/admin.html" },
        { "source": "/admin/**",    "destination": "/admin.html" },
        { "source": "/dashboard",   "destination": "/admin.html" },
        { "source": "/dashboard/**","destination": "/admin.html" },
        { "source": "**",           "destination": "/index.html" }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
