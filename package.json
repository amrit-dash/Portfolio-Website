{
  "name": "amrit-os-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "amrit.os — retro-OS portfolio with Firebase-backed admin console and AI agent",
  "scripts": {
    "help": "node scripts/help.mjs",
    "dev": "npx --yes serve public -l 3000",
    "start": "npx --yes serve public -l 3000",
    "build": "node scripts/build-dist.mjs",
    "preview": "npm run build && npx --yes serve dist/site -l 3001",
    "smoke": "npm run build && node scripts/smoke-dist.mjs",
    "test:inbox-triage": "node scripts/inbox-triage-test.cjs",
    "test:capability-probes": "node scripts/capability-probes-test.cjs",
    "deploy:site": "bash scripts/deploy-site.sh",
    "deploy:admin": "bash scripts/deploy-admin.sh",
    "deploy:backend": "bash scripts/deploy-backend.sh",
    "deploy:hosting": "npm run build && firebase deploy --only hosting:amritdash,hosting:amritos-admin --project amrit-dash-portfolio",
    "optimize:images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "firebase-tools": "^14.7.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "playwright": "^1.60.0"
  }
}
