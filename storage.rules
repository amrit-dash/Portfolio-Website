rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /portfolio/cv/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /portfolio/projects/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
