rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /cv/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /projects/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
